# TOMBSTONE — the dotfiles moved to https://github.com/embe221ed/dotfiles
#
# ~/.zshenv is read by EVERY zsh: every `zsh -c`, every script, every
# `docker exec zsh -c …`, every editor subshell. An unconditional `print -u2`
# here would inject two lines of stderr into all of them, for a week — which
# breaks anything that parses a zsh script's stderr and trains you to ignore the
# message you actually wanted to see. So: warn only when a human is looking.
# The chain below stays unguarded — that is the part that keeps the machine
# working, and it must run in non-interactive shells too.
[[ -o interactive ]] && {
  print -u2 "[!] dotfiles moved to https://github.com/embe221ed/dotfiles"
  print -u2 "[!] run: git clone https://github.com/embe221ed/dotfiles /opt/dotfiles && /opt/dotfiles/install.sh"
}
# Try every root this repo has ever suggested, not just the Mac's. A host that
# put its clone at /opt/dotfiles got the warning but no chain from the old form.
for _r in "${DOTFILES:-}" "$HOME/src/dotfiles" /opt/dotfiles; do
  [ -n "$_r" ] && [ -r "$_r/zsh/zshenv" ] && { . "$_r/zsh/zshenv"; break; }
done
unset _r
