# TOMBSTONE — the dotfiles moved to https://github.com/embe221ed/dotfiles
#
# LOUD on purpose, and unguarded: ~/.zshrc is only read by interactive shells,
# so there is a human here by definition. (Contrast configs/zsh/zshenv, which is
# read by every zsh in existence and therefore whispers.)
print -u2 "[!] dotfiles moved to https://github.com/embe221ed/dotfiles"
print -u2 "[!] run: git clone https://github.com/embe221ed/dotfiles /opt/dotfiles && /opt/dotfiles/install.sh"
for _r in "${DOTFILES:-}" "$HOME/src/dotfiles" /opt/dotfiles; do
  [ -n "$_r" ] && [ -r "$_r/zsh/zshrc" ] && { . "$_r/zsh/zshrc"; break; }
done
unset _r
