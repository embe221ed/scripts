# ~/.zshrc — interactive shell config, shared by the host and the dev container.
#
#   ln -sf /opt/scripts/configs/zsh/zshrc ~/.zshrc
#
# Machine-specific bits live in ~/.zshrc.local (sourced near the bottom, after
# the prompt theme). Everything a toolchain provides is guarded with a presence
# check, so this file is safe on a box where pyenv/rbenv/node/go are missing.
#
# ORDERING CONTRACT — anything that oh-my-zsh reads at load time (ZSH_THEME,
# plugins=(), fpath, CASE_SENSITIVE, the *_STRATEGY and zstyle knobs) MUST be set
# above `source $ZSH/oh-my-zsh.sh`. Appending it later is a silent no-op.

export ZSH="$HOME/.oh-my-zsh"

# Keep PATH/fpath (and their scalar twins) duplicate-free — before any PATH edit
# (also set in .zshenv; harmless and idempotent).
typeset -U path PATH fpath FPATH cdpath

# Keep the completion dump in the XDG cache (per host + zsh version), not $HOME.
export ZSH_COMPDUMP="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/.zcompdump-${HOST}-${ZSH_VERSION}"
mkdir -p "${ZSH_COMPDUMP:h}"

# The prompt theme is generated by interdotensional and symlinked to
# $ZSH_CUSTOM/themes/theme.zsh-theme by `interdot link`.
ZSH_THEME="theme"

CASE_SENSITIVE="false"
# Hyphen-insensitive completion: _ and - are interchangeable (needs CASE_SENSITIVE=false).
HYPHEN_INSENSITIVE="true"

zstyle ':fzf-tab:*' use-fzf-default-opts yes

# Order matters: fzf-tab loads before the widget-wrapping plugins;
# fast-syntax-highlighting stays late; history-substring-search loads after it.
# Custom (must be cloned into $ZSH_CUSTOM/plugins): fzf-tab, zsh-autosuggestions,
# fast-syntax-highlighting. The rest ship with oh-my-zsh.
plugins=(
  git
  virtualenv
  vi-mode
  direnv
  colored-man-pages
  extract
  fzf-tab
  zsh-autosuggestions
  fast-syntax-highlighting
  history-substring-search
  nvm
)

# Hand-written completions (_audits, _session, _svm, _rustup).
[[ -d /opt/scripts/configs/oh-my-zsh/completions ]] && fpath+=/opt/scripts/configs/oh-my-zsh/completions

# zsh-completions does not register itself on fpath when cloned into
# $ZSH_CUSTOM/plugins, so do it here — guarded, since it is not installed today.
_zc_src=${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-completions/src
[[ -d $_zc_src ]] && fpath+=$_zc_src
unset _zc_src

# Autosuggestions fall back to the completion engine when history misses.
# Must be set before oh-my-zsh.sh loads the plugin.
ZSH_AUTOSUGGEST_STRATEGY=(history completion)

# Lazy-load nvm via the bundled omz plugin — defers ~500ms off the critical path.
zstyle ':omz:plugins:nvm' lazy yes

source $ZSH/oh-my-zsh.sh

################################################################################
# User configuration (everything below runs after the theme is loaded)
################################################################################

export EDITOR='nvim'
export VISUAL='nvim'

# enable vi readline editing-mode.
# VI_MODE_SET_CURSOR / VI_MODE_RESET_PROMPT_ON_MODE_CHANGE are set by the
# generated interdot.zsh fragment ($ZSH_CUSTOM/interdot.zsh).
set -o vi

# --- light/dark ---------------------------------------------------------------
# DISPLAY_MODE is exported by the generated interdot.zsh fragment, which is
# sourced from $ZSH_CUSTOM/*.zsh — i.e. above, during oh-my-zsh.sh.
if [ "${DISPLAY_MODE}" = "Light" ]; then
  export BAT_THEME="gruvbox-light"
  COLORLS_CMD="colorls --light"
else
  export BAT_THEME="gruvbox-dark"
  COLORLS_CMD="colorls"
fi

# --- aliases ------------------------------------------------------------------
# The colorls aliases live down in the ruby section: colorls is a gem reached
# through the rbenv shims, and those are only on PATH after `rbenv init` runs.
alias now='command date +"%y/%m/%d %H:%M:%S"'  # pretty timestamp; leave `date` itself alone
alias t="tmux"

# --- pyenv --------------------------------------------------------------------
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && path=("$PYENV_ROOT/bin" $path)
(( $+commands[pyenv] )) && eval "$(pyenv init -)"

# --- rust ---------------------------------------------------------------------
[[ -r "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# --- go -----------------------------------------------------------------------
# These two hold however Go was installed (tarball, apt, govman), so they stay
# outside the govman guard — `go install` drops binaries in ~/go/bin regardless.
[[ -d "$HOME/go/bin" ]] && path=("$HOME/go/bin" $path)
export GOTOOLCHAIN=local

if [[ -x "$HOME/.govman/bin/govman" ]]; then
  path=("$HOME/.govman/bin" $path)
  [[ -n "$GOBIN" ]] && path=("$GOBIN" $path)
  (( $+commands[go] )) && path=("$(go env GOPATH)/bin" $path)

  # `govman use` prints an `export PATH=…` line that has to be eval'd in the
  # caller's shell; wrap it so switching versions actually takes effect.
  govman() {
    local govman_bin="$HOME/.govman/bin/govman"
    if [[ ("$1" == "use" && "$#" -ge 2 && "$2" != "--help" && "$2" != "-h") || "$1" == "refresh" ]]; then
      local output exit_code
      output="$("$govman_bin" "$@" 2>&1)"
      exit_code=$?
      if [[ $exit_code -eq 0 ]]; then
        local export_cmd=$(printf '%s\n' "$output" | grep -E '^export PATH=' | head -n 1)
        if [[ -n "$export_cmd" && "$export_cmd" =~ ^export\ PATH=\"[^\"]*\"$ ]]; then
          eval "$export_cmd"
          echo "✓ Go version switched successfully"
          return 0
        fi
      else
        echo "$output" >&2
        return $exit_code
      fi
    fi
    "$govman_bin" "$@"
  }

  # Auto-switch Go versions based on a .govman-goversion file.
  __govman_last_version=""
  govman_auto_switch() {
    local config_file="$HOME/.govman/config.yaml"
    local auto_switch_enabled="true"
    if [[ -f "$config_file" ]]; then
      auto_switch_enabled=$(awk '/^auto_switch:/,/^[^ ]/ {if (/^[[:space:]]*enabled:/) {print $2; exit}}' "$config_file" 2>/dev/null | tr -d '[:space:]')
      [[ -z "$auto_switch_enabled" ]] && auto_switch_enabled="true"
    fi
    [[ "$auto_switch_enabled" != "true" ]] && return 0

    [[ -s .govman-goversion ]] || return 0
    local required_version
    required_version=$(cat .govman-goversion 2>/dev/null | tr -d '\n\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [[ -z "$required_version" ]] && return 0
    if [[ ! "$required_version" =~ ^[0-9]+\.[0-9]+(\.?[0-9]*)(-?(rc|beta|alpha)[0-9]*)?$ ]]; then
      echo "Warning: Invalid version format in .govman-goversion: $required_version" >&2
      return 0
    fi
    [[ "$required_version" == "$__govman_last_version" ]] && return 0

    if ! (( $+commands[go] )); then
      echo "Go not found. Switching to Go $required_version..."
      govman use "$required_version" >/dev/null 2>&1 || \
        echo "Warning: Failed to switch to Go $required_version. Install it with 'govman install $required_version'" >&2
      return 0
    fi

    local current_version=$(go version 2>/dev/null | awk '{print $3}' | sed -E 's/^go//; s/([0-9]+\.[0-9]+(\.[0-9]+)?).*/\1/')
    [[ "$current_version" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]] || current_version=""
    if [[ -n "$current_version" && "$current_version" != "$required_version" ]]; then
      echo "Auto-switching to Go $required_version (required by .govman-goversion)"
      govman use "$required_version" >/dev/null 2>&1 || \
        echo "Warning: Failed to switch to Go $required_version. Install it with 'govman install $required_version'" >&2
      __govman_last_version="$required_version"
    elif [[ -n "$current_version" ]]; then
      __govman_last_version="$required_version"
    fi
  }

  autoload -U add-zsh-hook
  [[ "${chpwd_functions[(r)govman_auto_switch]}" ]] || add-zsh-hook chpwd govman_auto_switch
  govman_auto_switch
fi

# --- ruby ---------------------------------------------------------------------
[[ -x "$HOME/.rbenv/bin/rbenv" ]] && eval "$($HOME/.rbenv/bin/rbenv init - --no-rehash zsh)"

# colorls aliases — must come after `rbenv init`, which is what puts the shims
# (and therefore colorls) on PATH. Guarded so a box without ruby keeps a working
# `ls` instead of an alias to a missing command. COLORLS_CMD is set further up
# from DISPLAY_MODE.
if (( $+commands[colorls] )); then
  alias ls="${COLORLS_CMD}"
  alias ll="${COLORLS_CMD} -l --gs"
  alias la="${COLORLS_CMD} -la --gs"
else
  alias ll='ls -l'
  alias la='ls -la'
fi

# colorls ships its completion inside the gem; cache the path instead of forking
# `gem which colorls` on every startup. Guarded twice: `gem` may be a shim with no
# ruby behind it, in which case the output is empty and `dirname ""` yields "." —
# which would then be cached forever and error on every shell start.
if (( $+commands[colorls] )); then
  _colorls_tc="${XDG_CACHE_HOME:-$HOME/.cache}/colorls_tc_path"
  if [[ ! -s $_colorls_tc || ! -r "$(<$_colorls_tc)/tab_complete.sh" ]]; then
    _colorls_gem="$(gem which colorls 2>/dev/null)"
    [[ -n $_colorls_gem ]] && dirname "$_colorls_gem" >| $_colorls_tc
    unset _colorls_gem
  fi
  [[ -s $_colorls_tc && -r "$(<$_colorls_tc)/tab_complete.sh" ]] && source "$(<$_colorls_tc)/tab_complete.sh"
  unset _colorls_tc
fi

# --- fzf ----------------------------------------------------------------------
# The source checkout also ships fzf-tmux and fzf-preview.sh, which the release
# archive does not — tmux-fuzzback (prefix+/) shells out to `fzf-tmux` by name.
# Appended, so a newer fzf earlier on PATH still wins.
[[ -d /opt/tools/fzf/bin ]] && path+=/opt/tools/fzf/bin

# Colors first (generated by interdotensional), then the key bindings.
[[ -r /opt/tools/interdotensional/output/fzf/fzf-colors.sh ]] && \
  source /opt/tools/interdotensional/output/fzf/fzf-colors.sh
if (( $+commands[fzf] )); then
  source <(fzf --zsh)          # fzf >= 0.48
elif [[ -f ~/.fzf.zsh ]]; then
  source ~/.fzf.zsh
fi

# --- zoxide -------------------------------------------------------------------
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# --- machine-local overrides --------------------------------------------------
# Must be sourced AFTER the theme (oh-my-zsh loads $ZSH_CUSTOM/themes/ at the end
# of oh-my-zsh.sh), because the dev-container prompt badge edits $PROMPT.
[[ -r "${ZDOTDIR:-$HOME}/.zshrc.local" ]] && source "${ZDOTDIR:-$HOME}/.zshrc.local"

# Re-activate an inherited virtualenv. `exec zsh` (the safe way to reload — a full
# `source ~/.zshrc` stacks the autosuggestions/fast-syntax-highlighting widget
# wrappers until FUNCNEST blows) keeps VIRTUAL_ENV exported but rebuilds PATH from
# scratch above, demoting the venv's bin dir behind the pyenv/rbenv shims. Without
# this the prompt still shows the venv while `python` resolves elsewhere.
# An `if` (not `&& source`): this is the last command in the file, so a bare
# short-circuit would leave $? == 1 and paint a ✘ on the first prompt.
if [[ -n $VIRTUAL_ENV && -r $VIRTUAL_ENV/bin/activate ]]; then
  source $VIRTUAL_ENV/bin/activate
fi
